{
  "name": "ai-chatbot-fullstack-2026",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "nx run-many --target=serve --all --parallel=10",
    "dev:backend": "nx run-many --target=serve --projects=tag:type:backend --parallel=3",
    "dev:frontend": "nx run-many --target=serve --projects=tag:type:frontend --parallel=5",
    "dev:shell": "nx serve shell",
    "build": "nx run-many --target=build --all",
    "build:affected": "nx affected --target=build",
    "test": "nx run-many --target=test --all",
    "test:affected": "nx affected --target=test",
    "test:watch": "nx run-many --target=test --all --watch",
    "lint": "nx run-many --target=lint --all",
    "lint:affected": "nx affected --target=lint",
    "lint:fix": "nx run-many --target=lint --all --fix",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "graph": "nx graph",
    "affected:graph": "nx affected:graph",
    "reset": "nx reset",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "prisma:migrate": "cd apps/auth-service && npx prisma migrate dev",
    "prisma:generate": "cd apps/auth-service && npx prisma generate",
    "prisma:studio": "cd apps/auth-service && npx prisma studio"
  },
  "private": true,
  "devDependencies": {
