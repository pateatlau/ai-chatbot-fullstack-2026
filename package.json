{
  "name": "ai-chatbot-fullstack-2026",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "nx run-many --target=serve --all --parallel=10",
    "dev:backend": "nx run-many --target=serve --projects=auth-service,chatbot-service,admin-service --parallel=3",
    "dev:auth": "nx serve auth-service --inspect=false",
    "dev:chatbot": "cd apps/chatbot-service && npx prisma generate && cd ../.. && nx serve chatbot-service --inspect=false",
    "dev:admin": "nx serve admin-service --inspect=false",
    "dev:frontend": "nx run-many --target=serve --projects=tag:type:frontend --parallel=5",
    "dev:frontend:manual": "echo 'Start MFEs first in separate terminals:' && echo '1. npm run dev:chatbot-mfe' && echo '2. npm run dev:auth-mfe' && echo '3. npm run dev:admin-mfe (optional)' && echo '4. npm run dev:profile-mfe (optional)' && echo '5. npm run dev:shell' && echo '' && echo 'Wait for each to show READY before starting the next'",
    "dev:shell": "nx serve shell",
    "dev:shell:mock": "VITE_USE_MOCKS=true nx serve shell",
    "dev:auth-mfe": "nx serve auth-mfe",
    "dev:chatbot-mfe": "nx serve chatbot-mfe",
    "dev:admin-mfe": "nx serve admin-mfe",
    "dev:profile-mfe": "nx serve profile-mfe",
    "dev:profile-mfe:mock": "VITE_USE_MOCKS=true nx serve profile-mfe",
    "build": "nx run-many --target=build --all",
    "build:affected": "nx affected --target=build",
    "test": "nx run-many --target=test --all",
    "test:affected": "nx affected --target=test",
    "test:watch": "nx run-many --target=test --all --watch",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:smoke": "ts-node scripts/smoke-tests.ts --env=local",
    "test:smoke:staging": "ts-node scripts/smoke-tests.ts --env=staging",
    "test:smoke:production": "ts-node scripts/smoke-tests.ts --env=production",
    "lint": "nx run-many --target=lint --all",
    "lint:affected": "nx affected --target=lint",
    "lint:fix": "nx run-many --target=lint --all --fix",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "graph": "nx graph",
    "affected:graph": "nx affected:graph",
    "reset": "nx reset",
    "kill:backend": "lsof -ti:3000 | xargs kill -9 2>/dev/null; lsof -ti:3001 | xargs kill -9 2>/dev/null; lsof -ti:3002 | xargs kill -9 2>/dev/null; pkill -f 'nx serve' 2>/dev/null; echo '✓ All backend ports killed'",
    "kill:frontend": "lsof -ti:5173,5174,5175,5176,5177,5178,5179 | xargs kill -9 2>/dev/null; echo '✓ All frontend ports killed'",
    "kill:all": "npm run kill:backend && npm run kill:frontend",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:stop": "docker-compose stop",
    "docker:start": "docker-compose start",
    "docker:restart": "docker-compose restart",
    "docker:logs": "docker-compose logs -f",
    "docker:logs:postgres": "docker-compose logs -f postgres",
    "docker:logs:redis": "docker-compose logs -f redis",
    "docker:ps": "docker-compose ps",
    "docker:clean": "docker-compose down -v --remove-orphans",
    "docker:rebuild": "docker-compose down -v && docker-compose build --no-cache && docker-compose up -d",
    "docker:exec:postgres": "docker-compose exec postgres psql -U myapp -d myapp_dev",
    "docker:exec:redis": "docker-compose exec redis redis-cli",
    "docker:backup:postgres": "docker-compose exec -T postgres pg_dump -U myapp myapp_dev > backups/postgres_backup_$(date +%Y%m%d_%H%M%S).sql",
    "docker:restore:postgres": "cat backups/postgres_backup.sql | docker-compose exec -T postgres psql -U myapp myapp_dev",
    "docker:prune": "docker system prune -af --volumes",
    "docker:build:prod": "docker-compose -f docker-compose.prod.yml build",
    "docker:up:prod": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:down:prod": "docker-compose -f docker-compose.prod.yml down",
    "docker:logs:prod": "docker-compose -f docker-compose.prod.yml logs -f",
    "docker:migrate:prod": "docker-compose -f docker-compose.prod.yml exec auth-service sh -c 'cd prisma && npx prisma migrate deploy' && docker-compose -f docker-compose.prod.yml exec chatbot-service sh -c 'cd prisma && npx prisma migrate deploy'",
    "prisma:migrate": "cd apps/auth-service && npx prisma migrate dev",
    "prisma:generate": "cd apps/auth-service && npx prisma generate",
    "prisma:generate:all": "cd apps/auth-service && npx prisma generate && cd ../chatbot-service && npx prisma generate && cd ../..",
    "prisma:studio": "cd apps/auth-service && npx prisma studio"
  },
  "private": true,
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@module-federation/runtime": "^0.21.4",
    "@module-federation/vite": "^1.9.0",
    "@nx/cypress": "^22.0.3",
    "@nx/esbuild": "22.0.3",
    "@nx/eslint": "^22.0.3",
    "@nx/eslint-plugin": "^22.0.3",
    "@nx/jest": "^22.0.3",
    "@nx/js": "22.0.3",
    "@nx/node": "^22.0.3",
    "@nx/react": "^22.0.3",
    "@nx/vite": "^22.0.3",
    "@nx/web": "22.0.3",
    "@nx/workspace": "22.0.3",
    "@playwright/test": "^1.56.1",
    "@swc-node/register": "~1.9.1",
    "@swc/cli": "~0.6.0",
    "@swc/core": "~1.5.7",
    "@swc/helpers": "~0.5.11",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
