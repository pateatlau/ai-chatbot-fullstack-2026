# ==============================================
# REQUIRED Environment Variables
# ==============================================
# This file lists all environment variables that MUST be set
# for the application to function correctly.
#
# Variables listed here have NO sensible defaults and must be
# explicitly configured by the developer/operator.
#
# For optional variables with defaults, see .env.example

# ==============================================
# Database & Cache (REQUIRED)
# ==============================================
DATABASE_URL
REDIS_URL

# ==============================================
# JWT Configuration (CRITICAL - REQUIRED)
# ==============================================
# Must be identical across all services
# Generate with: openssl rand -base64 64
JWT_SECRET
JWT_REFRESH_SECRET

# ==============================================
# Frontend API URLs (REQUIRED)
# ==============================================
VITE_API_URL
VITE_GRAPHQL_GATEWAY_URL

# ==============================================
# Third-Party Services (REQUIRED for full functionality)
# ==============================================
# Required for chatbot functionality
# Optional if USE_MOCK_AI=true
OPENAI_API_KEY
