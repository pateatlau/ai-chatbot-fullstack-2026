# Production Environment Variables Template
# Copy this file to .env.production and fill in secure values

# ============================================================
# NODE ENVIRONMENT
# ============================================================
NODE_ENV=production

# ============================================================
# MONGODB CONFIGURATION (PRIMARY DATABASE)
# ============================================================

# Production MongoDB Connection (Replica Set)
MONGODB_URI=mongodb://chatbot_user:CHANGE_ME@mongodb-1:27017,mongodb-2:27017,mongodb-3:27017/chatbot?replicaSet=rs0&authSource=admin&ssl=true&retryWrites=true&w=majority

# MongoDB Admin Credentials (for initialization only)
MONGO_ROOT_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MONGO_APP_PASSWORD=CHANGE_ME_APP_PASSWORD
MONGO_MONITOR_PASSWORD=CHANGE_ME_MONITOR_PASSWORD

# MongoDB Connection Pool Settings
MONGODB_POOL_MIN=5
MONGODB_POOL_MAX=20
MONGODB_SOCKET_TIMEOUT=45000
MONGODB_CONNECT_TIMEOUT=10000
MONGODB_SERVER_SELECTION_TIMEOUT=30000

# ============================================================
# POSTGRESQL CONFIGURATION (BACKUP/MIGRATION)
# ============================================================

# PostgreSQL Connection (keep for 7 days post-migration)
DATABASE_URL=postgresql://chatbot_user:CHANGE_ME@postgres:5432/chatbot?sslmode=require&connect_timeout=10

# PostgreSQL Pool Settings
PG_POOL_MIN=5
PG_POOL_MAX=20
PG_POOL_IDLE_TIMEOUT=30000
PG_POOL_CONNECTION_TIMEOUT=10000

# ============================================================
# READ SWITCHER CONFIGURATION
# ============================================================

# MongoDB Read Percentage (0-100)
# Start at 0, gradually increase to 100
MONGODB_READ_PERCENTAGE=0

# Dual-Read Mode (enable for verification)
DUAL_READ_ENABLED=false

# Read Timeout Settings
READ_TIMEOUT_MS=5000
DUAL_READ_TIMEOUT_MS=10000

# ============================================================
# DUAL-WRITE CONFIGURATION
# ============================================================

# Enable dual-write to both databases
DUAL_WRITE_ENABLED=true

# Async write mode (don't block on secondary writes)
DUAL_WRITE_ASYNC=true

# Write timeout settings
WRITE_TIMEOUT_MS=10000

# ============================================================
# MONITORING & METRICS
# ============================================================

# Enable Prometheus metrics endpoint
METRICS_ENABLED=true
PROMETHEUS_ENDPOINT=/metrics
PROMETHEUS_PORT=9090

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_OUTPUT=stdout

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# ============================================================
# PERFORMANCE SETTINGS
# ============================================================

# Query Caching
QUERY_CACHE_ENABLED=true
QUERY_CACHE_TTL=300

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_MS=60000

# Request Timeout
REQUEST_TIMEOUT_MS=30000

# ============================================================
# SECURITY SETTINGS
# ============================================================

# JWT Configuration
JWT_SECRET=CHANGE_ME_STRONG_SECRET_KEY
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=7d

# CORS Configuration
CORS_ORIGIN=https://yourdomain.com
CORS_CREDENTIALS=true

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=100

# ============================================================
# REDIS CONFIGURATION (OPTIONAL)
# ============================================================

# Redis for session management and caching
REDIS_URL=redis://:CHANGE_ME@redis:6379
REDIS_SESSION_PREFIX=chatbot:session:
REDIS_CACHE_PREFIX=chatbot:cache:
REDIS_TTL=3600

# ============================================================
# BACKUP CONFIGURATION
# ============================================================

# MongoDB Backup Settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_DESTINATION=s3://your-bucket/mongodb-backups

# PostgreSQL Backup Settings (for migration period)
PG_BACKUP_ENABLED=true
PG_BACKUP_SCHEDULE=0 3 * * *  # Daily at 3 AM
PG_BACKUP_RETENTION_DAYS=7

# ============================================================
# ALERTING CONFIGURATION
# ============================================================

# Slack Alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#alerts
SLACK_USERNAME=Chatbot Monitor

# PagerDuty (Critical Alerts)
PAGERDUTY_API_KEY=CHANGE_ME
PAGERDUTY_SERVICE_KEY=CHANGE_ME

# Email Alerts
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=alerts@yourdomain.com
SMTP_PASSWORD=CHANGE_ME
ALERT_EMAIL_TO=ops-team@yourdomain.com

# ============================================================
# FEATURE FLAGS
# ============================================================

# Gradually enable MongoDB features
FEATURE_MONGODB_READS=true
FEATURE_MONGODB_WRITES=true
FEATURE_MONGODB_AGGREGATIONS=true

# Rollout percentages
ROLLOUT_MONGODB_READS=0
ROLLOUT_NEW_FEATURES=0

# ============================================================
# APPLICATION SETTINGS
# ============================================================

# Service Ports
CHATBOT_SERVICE_PORT=3001
AUTH_SERVICE_PORT=3002
ADMIN_SERVICE_PORT=3003
GRAPHQL_GATEWAY_PORT=4000

# External Services
OPENAI_API_KEY=CHANGE_ME
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# ============================================================
# DOCKER COMPOSE OVERRIDES
# ============================================================

# Container Resource Limits
MONGODB_CPU_LIMIT=2
MONGODB_MEMORY_LIMIT=4g
POSTGRES_CPU_LIMIT=1
POSTGRES_MEMORY_LIMIT=2g

# Replica Configuration
MONGODB_REPLICAS=3
POSTGRES_REPLICAS=2

# ============================================================
# MAINTENANCE WINDOWS
# ============================================================

# Define maintenance windows (UTC)
MAINTENANCE_WINDOW_START=02:00
MAINTENANCE_WINDOW_END=04:00
MAINTENANCE_DAY=Sunday

# ============================================================
# NOTES
# ============================================================

# Migration Timeline:
# Day 7 Hour 0: Deploy with MONGODB_READ_PERCENTAGE=0
# Day 7 Hour 1: Set MONGODB_READ_PERCENTAGE=10
# Day 7 Hour 2: Set MONGODB_READ_PERCENTAGE=25
# Day 7 Hour 3: Set MONGODB_READ_PERCENTAGE=50, DUAL_READ_ENABLED=false
# Day 7 Hour 4: Set MONGODB_READ_PERCENTAGE=75
# Day 7 Hour 5: Set MONGODB_READ_PERCENTAGE=90
# Day 7 Hour 6: Set MONGODB_READ_PERCENTAGE=100 (Full cutover)
# Day 14: Disable DUAL_WRITE_ENABLED, remove PostgreSQL

# Security Checklist:
# [ ] Change all passwords from defaults
# [ ] Enable TLS/SSL for MongoDB
# [ ] Enable TLS/SSL for PostgreSQL
# [ ] Configure firewall rules
# [ ] Set up VPN access only
# [ ] Enable audit logging
# [ ] Configure automated backups
# [ ] Test disaster recovery procedures
# [ ] Review and limit network access
# [ ] Enable connection encryption
