# ===============================================
# Admin Service - Environment Variables Template
# ===============================================

# Server Configuration
HOST=localhost
PORT=3002

# Database Configuration
# Individual connection parameters (alternative to DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myapp_prod
DB_USER=myapp
DB_PASSWORD=your_database_password_here

# JWT Configuration
# CRITICAL: Must match JWT_SECRET from auth-service exactly!
JWT_SECRET="CHANGE_THIS_TO_MATCH_AUTH_SERVICE_JWT_SECRET"

# Node Environment
NODE_ENV=production

# Logging (Optional)
LOG_LEVEL="info"  # Options: debug, info, warn, error

# CORS Configuration (Optional)
ALLOWED_ORIGINS="https://your-domain.com,https://admin.your-domain.com"
