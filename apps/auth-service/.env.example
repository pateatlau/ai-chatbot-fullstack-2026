# ==============================================
# Auth Service - Environment Variables Template
# ==============================================

# Database Configuration
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://myapp:your_password_here@localhost:5432/myapp_prod"

# Redis Configuration
# Redis connection string for session management and rate limiting
# Format: redis://[password@]host:port
REDIS_URL="redis://localhost:6379"

# JWT Configuration
# CRITICAL: Use strong, unique secrets in production (min 64 characters)
# Generate with: openssl rand -base64 64
JWT_SECRET="CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_IN_PRODUCTION"
JWT_REFRESH_SECRET="CHANGE_THIS_TO_A_DIFFERENT_SECURE_RANDOM_STRING"

# JWT token expiration times
JWT_EXPIRES_IN="15m"           # Access token: 15 minutes
JWT_REFRESH_EXPIRES_IN="7d"    # Refresh token: 7 days

# Frontend URL
# Used for password reset links, CORS, and redirects
FRONTEND_URL="https://your-domain.com"

# Server Configuration (Optional)
PORT=3000
NODE_ENV=production

# Logging (Optional)
LOG_LEVEL="info"  # Options: debug, info, warn, error
