# ================================================
# Chatbot Service - Environment Variables Template
# ================================================

# Database Configuration
# PostgreSQL connection string for chatbot data
DATABASE_URL="postgresql://myapp:your_password_here@localhost:5432/myapp_prod"

# OpenAI Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"        # or gpt-4, gpt-3.5-turbo
OPENAI_MAX_TOKENS=2000
OPENAI_CONTEXT_WINDOW=10

# Mock AI Mode (for testing without OpenAI API key)
# Set to 'false' in production
USE_MOCK_AI=false

# Redis Configuration
# Redis connection for rate limiting and caching
REDIS_URL="redis://localhost:6379"

# JWT Configuration
# CRITICAL: Must match JWT_SECRET from auth-service exactly!
JWT_SECRET="CHANGE_THIS_TO_MATCH_AUTH_SERVICE_JWT_SECRET"

# Server Configuration
PORT=3001
NODE_ENV=production

# Rate Limiting
# Maximum messages per user per minute
RATE_LIMIT_MAX_MESSAGES=10
RATE_LIMIT_WINDOW_MS=60000

# Logging (Optional)
LOG_LEVEL="info"  # Options: debug, info, warn, error
