# ==============================================
# Root Project - Environment Variables Template
# ==============================================
# This file documents environment variables used across the monorepo

# ==============================================
# CRITICAL SECURITY REQUIREMENTS
# ==============================================
# 1. JWT_SECRET must be IDENTICAL across all services (auth, admin, chatbot)
# 2. Use strong random strings (min 64 characters) for production
# 3. Generate secrets with: openssl rand -base64 64
# 4. Never commit .env files to version control
# 5. Use environment-specific secrets management (AWS Secrets Manager, etc.)

# ==============================================
# Database Configuration
# ==============================================
DATABASE_URL="postgresql://myapp:your_password_here@localhost:5432/myapp_prod"

# ==============================================
# Redis Configuration
# ==============================================
REDIS_URL="redis://localhost:6379"

# ==============================================
# JWT Configuration (SHARED ACROSS ALL SERVICES)
# ==============================================
JWT_SECRET="CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_MIN_64_CHARS"
JWT_REFRESH_SECRET="CHANGE_THIS_TO_A_DIFFERENT_SECURE_RANDOM_STRING"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ==============================================
# OpenAI Configuration (Chatbot Service)
# ==============================================
OPENAI_API_KEY="sk-your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"
OPENAI_MAX_TOKENS=2000
USE_MOCK_AI=false

# ==============================================
# Frontend Configuration
# ==============================================
FRONTEND_URL="https://your-domain.com"

# ==============================================
# Service Ports
# ==============================================
AUTH_SERVICE_PORT=3000
CHATBOT_SERVICE_PORT=3001
ADMIN_SERVICE_PORT=3002
SHELL_PORT=5173

# ==============================================
# Environment
# ==============================================
NODE_ENV=production
LOG_LEVEL=info

# ==============================================
# For detailed service-specific configuration, see:
# - apps/auth-service/.env.example
# - apps/admin-service/.env.example
# - apps/chatbot-service/.env.example
# ==============================================
