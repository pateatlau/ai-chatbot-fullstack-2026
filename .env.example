# ==============================================
# Root Project - Environment Variables Template
# ==============================================
# Copy this file to .env and update with your actual values
# Command: cp .env.example .env

# ==============================================
# CRITICAL SECURITY REQUIREMENTS
# ==============================================
# 1. JWT_SECRET must be IDENTICAL across all services (auth, admin, chatbot)
# 2. Use strong random strings (min 64 characters) for production
# 3. Generate secrets with: openssl rand -base64 64
# 4. Never commit .env files to version control
# 5. Use environment-specific secrets management (AWS Secrets Manager, etc.)

# ==============================================
# Database & Cache
# ==============================================
DATABASE_URL=postgresql://myapp:your_password_here@localhost:5432/myapp_dev
REDIS_URL=redis://localhost:6379

# ==============================================
# JWT Configuration (SHARED ACROSS ALL SERVICES)
# ==============================================
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_MIN_64_CHARS
JWT_REFRESH_SECRET=CHANGE_THIS_TO_A_DIFFERENT_SECURE_RANDOM_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==============================================
# Backend Services
# ==============================================
# Auth Service (Port 3000)
AUTH_SERVICE_PORT=3000
FRONTEND_URL=http://localhost:5173

# Chatbot Service (Port 3001)
CHATBOT_SERVICE_PORT=3001

# Admin Service (Port 3002)
ADMIN_SERVICE_PORT=3002

# GraphQL Gateway (Port 4000)
GRAPHQL_GATEWAY_PORT=4000

# ==============================================
# Frontend (Vite Environment Variables)
# ==============================================
# API URLs for MFEs
VITE_API_URL=http://localhost:3000
VITE_GRAPHQL_GATEWAY_URL=http://localhost:4000/graphql
VITE_AUTH_SERVICE_URL=http://localhost:3000
VITE_CHATBOT_SERVICE_URL=http://localhost:3001
VITE_ADMIN_SERVICE_URL=http://localhost:3002

# MFE Ports
VITE_SHELL_PORT=5173
VITE_AUTH_MFE_PORT=5174
VITE_CHATBOT_MFE_PORT=5175
VITE_ADMIN_MFE_PORT=5176
VITE_PROFILE_MFE_PORT=5177

# ==============================================
# Third-Party Services
# ==============================================
# OpenAI (Chatbot Service)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_MAX_TOKENS=2000

# ==============================================
# Development Flags
# ==============================================
NODE_ENV=development
LOG_LEVEL=debug
USE_MOCK_AI=false
